PORT=8000
RAG_BIND_HOST=127.0.0.1
RAG_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Generate one value with: openssl rand -hex 32
# Use the exact same value in server/.env.
RAG_SERVICE_TOKEN=
RAG_MAX_REQUEST_BYTES=1048576
# Replace every placeholder before startup. Generate passwords/secrets independently with:
# openssl rand -hex 32
# Direct PostgreSQL uses port 5432. With docker-compose.pgbouncer.yml, use 6432
# and keep RAG_DB_POOL_MAX small because PgBouncer owns the server pool.
DATABASE_URL=postgres://replace-with-postgres-user:replace-with-generated-postgres-password@127.0.0.1:5432/chatllm
RAG_DB_POOL_MAX=10
RAG_DB_POOL_TIMEOUT_MS=5000

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=replace-with-minio-access-key
S3_SECRET_KEY=replace-with-generated-minio-secret-key
S3_BUCKET=documents
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=document_chunks
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE
MILVUS_HNSW_M=16
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_SEARCH_EF=64
MILVUS_INSERT_BATCH_SIZE=500

ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=chatllm_chunks_v2
ELASTICSEARCH_SCHEMA_VERSION=markdown-fields-v2
# Changing either value requires re-ingesting existing Markdown into the new index.
ELASTICSEARCH_TIMEOUT_MS=2000
ELASTICSEARCH_NUMBER_OF_SHARDS=1
ELASTICSEARCH_NUMBER_OF_REPLICAS=0
ELASTICSEARCH_BULK_BATCH_SIZE=500
ELASTICSEARCH_REFRESH_ON_WRITE=false

NEO4J_ENABLED=true
NEO4J_URL=http://127.0.0.1:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-generated-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_TIMEOUT_MS=60000
NEO4J_BATCH_SIZE=100

# Evidence-grounded LLM graph extraction. Rules-only mode is intentionally
# reported as degraded and is not an enterprise production configuration.
# Graph extraction never reuses Judge credentials implicitly. Configure all
# GRAPH_EXTRACTION_* provider fields together before setting this to true.
GRAPH_EXTRACTION_ENABLED=false
GRAPH_EXTRACTION_API_KEY=
GRAPH_EXTRACTION_BASE_URL=
GRAPH_EXTRACTION_MODEL=
GRAPH_EXTRACTION_TIMEOUT_MS=15000
GRAPH_EXTRACTOR_VERSION=llm-json-v2
GRAPH_ONTOLOGY_VERSION=core-v2
# Same-section radius on each side: 1 = target + previous/next, 2 = two on each side.
GRAPH_CONTEXT_WINDOW_CHUNKS=1
# Cached model payloads have document usage references and expire automatically.
GRAPH_EXTRACTION_CACHE_TTL_DAYS=30
# Search is hard bounded to at most three hops.
GRAPH_SEARCH_MAX_HOPS=3
GRAPH_SEARCH_MAX_BRANCH_FACTOR=8
GRAPH_SEARCH_MAX_PATHS=24
GRAPH_SEARCH_HUB_DEGREE_LIMIT=40

EMBEDDING_PROVIDER=compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://llm-ro9cl3th56gnvkzo.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024

# Optional semantic rerank after RRF. The provider must expose POST /rerank
# with index/relevance_score results. Any failure falls back to local ordering.
RERANKER_ENABLED=false
RERANKER_API_KEY=
RERANKER_BASE_URL=
RERANKER_MODEL=
RERANKER_TIMEOUT_MS=2500
RERANKER_TOP_N=20
RERANKER_MAX_DOCUMENT_CHARS=4000

# Optional semantic standalone-query and multi-query rewrite. Strict JSON and
# exact-marker validation protect the deterministic fallback from invented IDs.
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_API_KEY=
QUERY_REWRITE_BASE_URL=
QUERY_REWRITE_MODEL=
QUERY_REWRITE_TIMEOUT_MS=2500
QUERY_REWRITE_MAX_ALTERNATIVES=2
RAG_JUDGE_ENABLED=false
RAG_JUDGE_API_KEY=
RAG_JUDGE_BASE_URL=https://api.moonshot.cn/v1
RAG_JUDGE_MODEL=moonshot-v1-8k
RAG_JUDGE_TIMEOUT_MS=10000
RAG_READINESS_TIMEOUT_MS=8000
RAG_INGEST_CONCURRENCY=4
RAG_INGEST_STREAMING_THRESHOLD_BYTES=52428800
RAG_INGEST_CHUNK_BATCH_SIZE=100
RAG_INGEST_EMBEDDING_BATCH_SIZE=10
# Planned query variants run concurrently, while each variant keeps its own
# bounded vector/keyword/graph routing. Keep this small to protect dependencies.
AGENTIC_QUERY_PARALLELISM=3
REDIS_URL=redis://:replace-with-generated-redis-password@127.0.0.1:6379/0
# REDIS_URL identifies the durable queue/rate-limit Redis and is never used for
# disposable RAG cache data. Start the optional cache instance with:
# `docker compose up -d` starts this disposable instance separately from queue Redis.
CACHE_REDIS_URL=redis://:${CACHE_REDIS_PASSWORD}@127.0.0.1:6380/0
# Cache remains fail-safe disabled unless explicitly enabled. If CACHE_REDIS_URL
# is missing or equals REDIS_URL, the service disables L1 instead of sharing the
# queue instance.
REDIS_CACHE_ENABLED=true
REDIS_CACHE_TTL_SECONDS=21600
REDIS_CACHE_SINGLEFLIGHT_WAIT_MS=800
REDIS_CACHE_SINGLEFLIGHT_LOCK_SECONDS=30
