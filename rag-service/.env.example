S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_FORCE_PATH_STYLE=true

MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=document_chunks
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE
MILVUS_HNSW_M=16
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_SEARCH_EF=64
MILVUS_INSERT_BATCH_SIZE=500

ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=chatllm_chunks
ELASTICSEARCH_TIMEOUT_MS=2000
ELASTICSEARCH_NUMBER_OF_SHARDS=1
ELASTICSEARCH_NUMBER_OF_REPLICAS=0
ELASTICSEARCH_BULK_BATCH_SIZE=500
ELASTICSEARCH_REFRESH_ON_WRITE=false

NEO4J_ENABLED=true
