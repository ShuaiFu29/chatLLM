# This file only configures Docker infrastructure. Replace every replace-with-* value
# before startup, then copy the matching credentials into server/.env and rag-service/.env.
# Infrastructure ports stay local unless an operator deliberately changes this value.
INFRA_BIND_HOST=127.0.0.1

# Generate independently with: openssl rand -hex 32
REDIS_PASSWORD=replace-with-generated-redis-password
REDIS_MAXMEMORY=512mb
# Disposable RAG exact-cache instance. Generate this independently from
# REDIS_PASSWORD in production; it must not share the queue Redis.
CACHE_REDIS_PASSWORD=replace-with-generated-cache-redis-password
CACHE_REDIS_MAXMEMORY=256mb
CACHE_REDIS_PORT=6380

POSTGRES_DB=chatllm
POSTGRES_USER=chatllm
# Generate independently with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-generated-postgres-password
# Optional PgBouncer override (`npm run dev:infra:pgbouncer`). Applications then
# connect to 127.0.0.1:6432 and keep their own client pools deliberately small.
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_SIZE=5

MINIO_ROOT_USER=chatllm-minio
# Generate independently with: openssl rand -hex 32
MINIO_ROOT_PASSWORD=replace-with-generated-minio-password

MILVUS_MINIO_ROOT_USER=chatllm-milvus-minio
# Generate independently with: openssl rand -hex 32
MILVUS_MINIO_ROOT_PASSWORD=replace-with-generated-milvus-minio-password

NEO4J_USER=neo4j
# Generate independently with: openssl rand -hex 32
NEO4J_PASSWORD=replace-with-generated-neo4j-password
